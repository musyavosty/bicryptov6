FROM cassandra:4.1
COPY scripts/cassandra-init.sh /cassandra-init.sh
RUN chmod +x /cassandra-init.sh

# Patch cassandra.yaml at build time:
# 1. Enable materialized views (disabled by default in Cassandra 4.1)
# 2. Remove rpc_interface lines so the init script can manage rpc_address cleanly
#    at runtime (it exports the real container IP as CASSANDRA_RPC_ADDRESS so
#    docker-entrypoint.sh writes a concrete IP — no broadcast_rpc_address needed).
RUN ( sed -i 's/^# materialized_views_enabled:.*/materialized_views_enabled: true/' \
          /etc/cassandra/cassandra.yaml || true ) && \
    ( grep -q '^materialized_views_enabled:' /etc/cassandra/cassandra.yaml || \
      echo 'materialized_views_enabled: true' >> /etc/cassandra/cassandra.yaml ) && \
    sed -i '/^rpc_interface:/d' /etc/cassandra/cassandra.yaml && \
    sed -i '/^# rpc_interface:/d' /etc/cassandra/cassandra.yaml

ENTRYPOINT ["/cassandra-init.sh"]
CMD ["cassandra", "-R", "-f"]
