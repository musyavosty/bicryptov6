FROM cassandra:4.1
COPY scripts/cassandra-init.sh /cassandra-init.sh
RUN chmod +x /cassandra-init.sh

# Pre-patch rpc_address at build time (belt+suspenders — init script also patches at runtime)
RUN sed -i 's/rpc_address: localhost/rpc_address: 0.0.0.0/' /etc/cassandra/cassandra.yaml

ENTRYPOINT ["/cassandra-init.sh"]
CMD ["cassandra", "-R", "-f"]
